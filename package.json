{
  "name": "invoice-extractor-v1",
  "private": true,
  "description": "Root helpers; backend app lives in ./backend",
  "scripts": {
    "check:env": "npm run check:env --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "test:integration": "npm run test:integration --prefix backend",
    "db:up": "node scripts/db-up.mjs",
    "db:down": "docker compose -f docker/docker-compose.db.yml down",
    "db:logs": "docker compose -f docker/docker-compose.db.yml logs -f postgres",
    "db:setup": "node scripts/db-setup.mjs",
    "db:setup:local": "npm run db:wait --prefix backend && npm run db:migrate --prefix backend",
    "db:truncate": "npm run db:truncate --prefix backend",
    "db:count": "npm run db:count --prefix backend",
    "db:tables": "npm run db:tables --prefix backend",
    "db:truncate:all": "npm run db:truncate:all --prefix backend",
    "db:wait": "npm run db:wait --prefix backend",
    "test:integration:local": "npm run db:setup && npm run test:integration --prefix backend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "test:frontend": "npm test --prefix frontend",
    "test:e2e": "playwright test",
    "test:all": "npm test --prefix backend && npm run test:frontend && npm run test:integration --prefix backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
