FROM node:24-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./

# Set at build time: docker build --build-arg VITE_API_URL=https://your-api.up.railway.app ...
ARG VITE_API_URL=http://localhost:3000
ARG VITE_APP_NAME=Thai Invoice Extractor
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_NAME=$VITE_APP_NAME

RUN npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY frontend/package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
ENV PORT=8080
EXPOSE 8080
CMD ["npm", "start"]
