{
  "name": "thai-invoice-extractor-backend",
  "version": "0.1.0",
  "description": "Thai Invoice Extraction System - Backend (Node 24 LTS + Express + Claude Vision)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "copyfiles -u 1 \"src/prompts/**/*\" dist && copyfiles -u 3 \"src/db/migrations/**/*.sql\" dist/db/migrations",
    "prestart": "node --input-type=module -e \"import fs from 'node:fs'; fs.accessSync('dist/server.js');\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "check:env": "tsx scripts/check-env-connectivity.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:truncate": "tsx scripts/db-truncate.ts --confirm",
    "db:truncate:all": "tsx scripts/db-truncate.ts --confirm --legacy --uploads",
    "db:count": "tsx scripts/db-count.ts",
    "db:tables": "tsx scripts/db-list-tables.ts",
    "db:diagnose": "tsx scripts/db-diagnose-extractions.ts",
    "db:wait": "tsx scripts/wait-for-postgres.ts",
    "db:setup": "npm --prefix .. run db:setup",
    "db:setup:local": "npm run db:wait && npm run db:migrate",
    "db:up": "npm --prefix .. run db:up",
    "jwt:dev": "tsx scripts/issue-dev-jwt.ts",
    "user:seed": "tsx scripts/seed-user.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:jwt": "tsx scripts/jwt-self-test.ts",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "winston": "^3.15.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.0.1"
  }
}
