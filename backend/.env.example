# Backend environment template
NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker/docker-compose.db.yml when using npm run db:up)
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice_extractor
# Start local Postgres:  npm run db:up   (repo root, requires Docker)
# Create tables:        npm run db:setup   (repo root or backend/)
#                      or: npm run db:migrate
# Integration tests:    cd backend && npm run test:integration
# INTEGRATION_DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice_extractor_test

# Anthropic Claude API (vision extraction)
# Create a key at https://console.anthropic.com/ — never commit real keys.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model id from https://docs.anthropic.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-sonnet-4-6

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# Logging
LOG_LEVEL=info

# JWT (HS256) — access tokens for /api/thai-invoices/upload
# Generate a random 32+ character secret for local dev (never commit real secrets).
JWT_SECRET=replace-with-random-string-at-least-32-chars
JWT_ISSUER=thai-invoice-extractor
JWT_AUDIENCE=thai-invoice-api

# Local JWT for curl (uses backend/.env):
#   npm run jwt:dev -- your-user-id

# Upload rate limit (per JWT user, sliding window)
UPLOAD_RATE_LIMIT_MAX=100
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=15

# CORS — must match your frontend URL (Vite default: http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173

# Auth — email/password + optional Microsoft/Google SSO
PUBLIC_API_BASE_URL=http://localhost:3000
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
JWT_ACCESS_EXPIRES_IN=15m
# Restrict login/SSO to org domains (comma-separated). Empty = any domain.
# AUTH_ALLOWED_EMAIL_DOMAINS=synnex.com

# Create first local user: npm run user:seed -- admin@example.com 'ChangeMe123!' admin

# Microsoft Entra ID (optional — enable organizational sign-in)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Google Workspace (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Token usage dashboard estimates (USD per 1M tokens)
CLAUDE_INPUT_COST_PER_MILLION_USD=3
CLAUDE_OUTPUT_COST_PER_MILLION_USD=15
